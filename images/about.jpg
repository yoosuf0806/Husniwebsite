<svg xmlns="http://www.w3.org/2000/svg" width="500" height="625">
<defs>
  <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#CFC5BB"/><stop offset="100%" stop-color="#8A7A6A"/></linearGradient>
</defs>
<rect width="500" height="625" fill="url(#bg)"/>
<!-- Office wall -->
<rect y="140" width="500" height="485" fill="#EDE5DC" opacity="0.65"/>
<!-- Window -->
<rect x="40" y="160" width="170" height="240" fill="#C8E4F0" opacity="0.55"/>
<rect x="36" y="156" width="4" height="248" fill="#8B7355"/>
<rect x="208" y="156" width="4" height="248" fill="#8B7355"/>
<rect x="36" y="156" width="176" height="4" fill="#8B7355"/>
<rect x="36" y="400" width="176" height="4" fill="#8B7355"/>
<rect x="121" y="160" width="4" height="240" fill="#8B7355" opacity="0.4"/>
<rect x="40" y="276" width="168" height="4" fill="#8B7355" opacity="0.4"/>
<!-- Light rays -->
<polygon points="40,160 208,160 260,400 0,400" fill="#FFF8EE" opacity="0.15"/>
<!-- Desk surface -->
<rect y="430" width="500" height="14" fill="#7A5A3A"/>
<rect y="444" width="500" height="181" fill="#9A7A5A" opacity="0.45"/>
<!-- Person silhouette  -->
<ellipse cx="290" cy="340" rx="32" ry="34" fill="#4A3828" opacity="0.7"/>
<rect x="258" y="372" width="64" height="80" fill="#3A2818" opacity="0.6" rx="5"/>
<!-- Arms -->
<rect x="240" y="430" width="80" height="14" fill="#4A3828" opacity="0.5" rx="7"/>
<!-- Laptop -->
<rect x="300" y="395" width="140" height="90" fill="#1E2D3E" rx="4" opacity="0.9"/>
<rect x="308" y="403" width="124" height="74" fill="#2A3D52" rx="2"/>
<rect x="285" y="483" width="170" height="6" fill="#1E2D3E" rx="2" opacity="0.8"/>
<!-- Screen glow -->
<rect x="310" y="405" width="120" height="70" fill="#3A5A80" opacity="0.25"/>
<!-- Drawings/plans on desk -->
<rect x="30" y="440" width="160" height="115" fill="#FAFAF5" opacity="0.95" rx="1"/>
<line x1="45" y1="460" x2="175" y2="460" stroke="#1B2A4A" stroke-width="0.8" opacity="0.4"/>
<line x1="45" y1="474" x2="160" y2="474" stroke="#1B2A4A" stroke-width="0.8" opacity="0.3"/>
<line x1="45" y1="488" x2="168" y2="488" stroke="#1B2A4A" stroke-width="0.8" opacity="0.3"/>
<rect x="55" y="500" width="55" height="40" fill="none" stroke="#1B2A4A" stroke-width="0.8" opacity="0.4"/>
<rect x="118" y="500" width="40" height="40" fill="none" stroke="#1B2A4A" stroke-width="0.8" opacity="0.3"/>
<!-- Coffee mug -->
<ellipse cx="460" cy="440" rx="18" ry="8" fill="#C8A870" opacity="0.8"/>
<rect x="443" y="412" width="34" height="30" fill="#7A5A3A" rx="3"/>
<path d="M477 422 Q490 422 490 432 Q490 442 477 442" fill="none" stroke="#7A5A3A" stroke-width="3"/>
<!-- Books on wall shelf -->
<rect x="280" y="170" width="210" height="4" fill="#7A5A3A"/>
<rect x="285" y="174" width="22" height="60" fill="#8B3A2A" opacity="0.8" rx="1"/>
<rect x="311" y="174" width="16" height="60" fill="#2A5A3A" opacity="0.8" rx="1"/>
<rect x="331" y="174" width="24" height="60" fill="#3A3A6A" opacity="0.8" rx="1"/>
<rect x="359" y="174" width="18" height="60" fill="#6A5A1A" opacity="0.8" rx="1"/>
<rect x="381" y="174" width="20" height="60" fill="#4A2A1A" opacity="0.8" rx="1"/>
<!-- Gold accent bottom -->
<rect y="580" width="500" height="45" fill="#1B2A4A"/>
<text x="250" y="608" font-family="Georgia,serif" font-size="11" fill="#C9A96E" text-anchor="middle" letter-spacing="3">HUSNI MARIKKAR · ARCHITECT · LONDON</text>
</svg>