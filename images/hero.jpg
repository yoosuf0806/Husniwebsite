<svg xmlns="http://www.w3.org/2000/svg" width="600" height="800">
<defs>
  <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#E8E0D5"/><stop offset="100%" stop-color="#C8BEB5"/></linearGradient>
  <linearGradient id="floor" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#B8A898"/><stop offset="100%" stop-color="#8C7B6B"/></linearGradient>
  <linearGradient id="wall" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#D5CAC0"/><stop offset="100%" stop-color="#EDE5DC"/></linearGradient>
</defs>
<!-- Room background -->
<rect width="600" height="800" fill="url(#sky)"/>
<rect y="550" width="600" height="250" fill="url(#floor)"/>
<rect width="600" height="800" fill="url(#wall)" opacity="0.3"/>
<!-- Large window with light -->
<rect x="160" y="80" width="280" height="420" fill="#D4EAF5" opacity="0.6"/>
<rect x="160" y="80" width="280" height="420" fill="white" opacity="0.15"/>
<!-- Window frames -->
<rect x="156" y="76" width="6" height="428" fill="#8B7355"/>
<rect x="434" y="76" width="6" height="428" fill="#8B7355"/>
<rect x="156" y="76" width="284" height="6" fill="#8B7355"/>
<rect x="156" y="498" width="284" height="6" fill="#8B7355"/>
<rect x="295" y="80" width="6" height="418" fill="#8B7355" opacity="0.5"/>
<rect x="160" y="280" width="274" height="6" fill="#8B7355" opacity="0.5"/>
<!-- Sunlight wash -->
<polygon points="162,82 438,82 540,560 60,560" fill="#FFF8EE" opacity="0.12"/>
<!-- Architect desk -->
<rect x="30" y="520" width="220" height="14" fill="#6B5033" rx="2"/>
<rect x="30" y="534" width="220" height="180" fill="#8B6B4A" opacity="0.5"/>
<rect x="40" y="510" width="180" height="4" fill="#5A4023"/>
<!-- Drawings on desk -->
<rect x="45" y="536" width="120" height="90" fill="#FAFAF5" rx="1"/>
<line x1="55" y1="555" x2="155" y2="555" stroke="#1B2A4A" stroke-width="0.8" opacity="0.5"/>
<line x1="55" y1="568" x2="140" y2="568" stroke="#1B2A4A" stroke-width="0.8" opacity="0.3"/>
<line x1="55" y1="581" x2="148" y2="581" stroke="#1B2A4A" stroke-width="0.8" opacity="0.3"/>
<rect x="65" y="593" width="50" height="28" fill="none" stroke="#1B2A4A" stroke-width="0.8" opacity="0.4"/>
<!-- Architect silhouette -->
<ellipse cx="330" cy="430" rx="28" ry="30" fill="#4A3A2A" opacity="0.65"/>
<rect x="304" y="458" width="52" height="100" fill="#3A2A1A" opacity="0.55" rx="5"/>
<rect x="280" y="520" width="100" height="16" fill="#4A3A2A" opacity="0.45" rx="8"/>
<!-- Chair -->
<rect x="290" y="510" width="80" height="12" fill="#7A5A3A" rx="3"/>
<rect x="300" y="522" width="60" height="4" fill="#6A4A2A"/>
<!-- Lamp -->
<rect x="480" y="100" width="4" height="380" fill="#5A4A3A"/>
<polygon points="445,100 525,100 500,180 470,180" fill="#C8A870" opacity="0.9"/>
<ellipse cx="485" cy="185" rx="30" ry="8" fill="#FFE8B0" opacity="0.3"/>
<!-- Shelves -->
<rect x="480" y="160" width="110" height="3" fill="#7A5A3A"/>
<rect x="480" y="220" width="110" height="3" fill="#7A5A3A"/>
<rect x="485" y="163" width="16" height="55" fill="#8B3A2A" opacity="0.8"/>
<rect x="505" y="163" width="12" height="55" fill="#2A4A3A" opacity="0.8"/>
<rect x="521" y="163" width="18" height="55" fill="#3A3A5A" opacity="0.8"/>
<rect x="485" y="223" width="20" height="45" fill="#5A3A1A" opacity="0.7"/>
<rect x="510" y="223" width="14" height="45" fill="#1A3A4A" opacity="0.7"/>
<!-- Floor reflection line -->
<line x1="0" y1="552" x2="600" y2="552" stroke="#C9A96E" stroke-width="1.5" opacity="0.4"/>
<!-- Bottom info bar -->
<rect y="720" width="600" height="80" fill="#1B2A4A" opacity="0.85"/>
<line x1="40" y1="730" x2="40" y2="790" stroke="#C9A96E" stroke-width="3"/>
<text x="54" y="750" font-family="Georgia,serif" font-size="13" fill="#C9A96E" letter-spacing="2">HUSNI MARIKKAR</text>
<text x="54" y="770" font-family="Georgia,serif" font-size="10" fill="rgba(255,255,255,0.65)" letter-spacing="1.5">ARCHITECT &amp; INTERIOR DESIGNER · LONDON</text>
</svg>