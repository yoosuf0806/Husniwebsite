<svg xmlns="http://www.w3.org/2000/svg" width="600" height="800" viewBox="0 0 600 800">
<defs>
  <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#C8BFB5"/><stop offset="100%" stop-color="#7A6E65"/></linearGradient>
  <linearGradient id="wall" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#E8E0D8"/><stop offset="100%" stop-color="#C4BAB0"/></linearGradient>
  <linearGradient id="floor" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#B8A898"/><stop offset="100%" stop-color="#9A8878"/></linearGradient>
</defs>
<rect width="600" height="800" fill="url(#bg)"/>
<!-- Room interior -->
<rect x="0" y="200" width="600" height="600" fill="url(#wall)"/>
<rect x="0" y="580" width="600" height="220" fill="url(#floor)"/>
<!-- Window light -->
<rect x="180" y="220" width="240" height="320" fill="#F5EDD8" opacity="0.7"/>
<rect x="190" y="230" width="220" height="300" fill="#FFF5E0" opacity="0.5"/>
<!-- Window frame -->
<rect x="180" y="220" width="4" height="320" fill="#8B7355"/>
<rect x="416" y="220" width="4" height="320" fill="#8B7355"/>
<rect x="180" y="378" width="240" height="4" fill="#8B7355"/>
<rect x="296" y="220" width="4" height="320" fill="#8B7355" opacity="0.5"/>
<!-- Furniture silhouette - desk -->
<rect x="80" y="510" width="200" height="80" fill="#6B5A4A" rx="2"/>
<rect x="90" y="590" width="20" height="50" fill="#5A4A3A"/>
<rect x="250" y="590" width="20" height="50" fill="#5A4A3A"/>
<!-- Chair -->
<rect x="120" y="470" width="80" height="60" fill="#8B7355" rx="4"/>
<rect x="130" y="530" width="60" height="8" fill="#7A6345"/>
<!-- Plant -->
<rect x="420" y="500" width="20" height="80" fill="#5A4A3A"/>
<ellipse cx="430" cy="500" rx="40" ry="50" fill="#4A6B3A" opacity="0.8"/>
<ellipse cx="430" cy="490" rx="30" ry="35" fill="#5A7B4A" opacity="0.7"/>
<!-- Ceiling light -->
<rect x="270" y="160" width="60" height="4" fill="#8B7355"/>
<rect x="290" y="164" width="20" height="40" fill="#C8A870" opacity="0.8"/>
<ellipse cx="300" cy="210" rx="25" ry="6" fill="#FFE8B0" opacity="0.4"/>
<!-- Architect figure silhouette -->
<ellipse cx="350" cy="390" rx="18" ry="20" fill="#4A3A2A" opacity="0.6"/>
<rect x="334" y="408" width="32" height="80" fill="#4A3A2A" opacity="0.5" rx="4"/>
<!-- Floor reflection -->
<rect x="0" y="600" width="600" height="4" fill="#C9A96E" opacity="0.3"/>
<!-- Gold accent line -->
<rect x="0" y="196" width="600" height="4" fill="#C9A96E" opacity="0.6"/>
<!-- Text overlay area -->
<rect x="0" y="680" width="600" height="120" fill="#1B2A4A" opacity="0.75"/>
<text x="300" y="715" font-family="Georgia,serif" font-size="14" fill="#C9A96E" text-anchor="middle" letter-spacing="3">HUSNI MARIKKAR</text>
<text x="300" y="738" font-family="Georgia,serif" font-size="11" fill="rgba(255,255,255,0.7)" text-anchor="middle" letter-spacing="2">ARCHITECT &amp; INTERIOR DESIGNER</text>
<text x="300" y="758" font-family="Georgia,serif" font-size="10" fill="rgba(255,255,255,0.5)" text-anchor="middle" letter-spacing="1">LONDON, UK</text>
</svg>